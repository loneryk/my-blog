---
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import type { HeroStickerConfig } from "@/types/config";

interface Props {
	config: HeroStickerConfig;
}

const { config } = Astro.props;

// 贴纸图解析：public（"/" 开头）/ 远程 URL 直接用；src 目录走 glob 取构建后地址
const imageFiles = import.meta.glob<ImageMetadata>(
	"../../assets/**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
	{ import: "default" },
);

let stickerSrc: string = config.image;
let stickerWidth: number | undefined;
let stickerHeight: number | undefined;

if (!config.image.startsWith("/") && !config.image.startsWith("http")) {
	const normalizedPath = path
		.normalize(path.join("../../", config.image))
		.replace(/\\/g, "/");
	const file = imageFiles[normalizedPath];
	if (file) {
		const meta = await file();
		stickerSrc = meta.src;
		stickerWidth = meta.width;
		stickerHeight = meta.height;
	}
}

// 五官追踪仅在眼睛/嘴巴坐标齐全时启用；纯 logo 贴纸无需追踪
const stickerStyle =
	config.eye && config.rightEye && config.mouth
		? [
				`--home-hero-left-eye-x: ${config.eye.xPercent}%`,
				`--home-hero-left-eye-y: ${config.eye.yPercent}%`,
				`--home-hero-right-eye-x: ${config.rightEye.xPercent}%`,
				`--home-hero-right-eye-y: ${config.rightEye.yPercent}%`,
				`--home-hero-mouth-x: ${config.mouth.xPercent}%`,
				`--home-hero-mouth-y: ${config.mouth.yPercent}%`,
				`--home-hero-mouth-width: ${config.mouth.widthPercent}%`,
				`--home-hero-mouth-height: ${config.mouth.heightPercent}%`,
				`--home-hero-mouth-rotation: ${config.mouth.rotation}deg`,
			].join(";")
		: "";
---

<figure
	class="home-hero__sticker"
	style={stickerStyle}
	data-hero-sticker
	data-eye-travel-x={config.eye?.travelXPercent ?? 0}
	data-eye-travel-y={config.eye?.travelYPercent ?? 0}
>
	<img
		class="home-hero__sticker-image"
		src={stickerSrc}
		alt={config.alt}
		width={stickerWidth}
		height={stickerHeight}
		loading="eager"
		decoding="async"
	/>
	{config.eye && config.rightEye && config.mouth && (
		<>
			<span
				class="home-hero__sticker-feature home-hero__sticker-eye home-hero__sticker-eye--left"
				data-hero-sticker-feature
				data-motion-scale="1"
				aria-hidden="true"
			>
				<span class="home-hero__sticker-eye-pupil"></span>
			</span>
			<span
				class="home-hero__sticker-feature home-hero__sticker-eye home-hero__sticker-eye--right"
				data-hero-sticker-feature
				data-motion-scale="1"
				aria-hidden="true"
			>
				<span class="home-hero__sticker-eye-pupil"></span>
			</span>
			<span
				class="home-hero__sticker-feature home-hero__sticker-mouth"
				data-hero-sticker-feature
				data-motion-scale={config.mouth.travelScale}
				aria-hidden="true"
			></span>
		</>
	)}
</figure>
